--============ NAME MATCHING ============
local function scoreMatch(query, candidate)
    if query == "" or candidate == "" then return 0 end
    local q = query:lower():gsub("^%s+", ""):gsub("%s+$", "")
    local c = candidate:lower()
    if q == "" then return 0 end
    if q == c then return 1000 end

    local s = 0
    if c:sub(1, #q) == q then s = s + 420 end
    if c:find(q, 1, true) then s = s + 260 end

    local words, hits = 0, 0
    for w in q:gmatch("%S+") do
        words = words + 1
        if c:find(w, 1, true) then hits = hits + 1 end
    end
    if words > 0 then s = s + (hits / words) * 300 end

    local ci, chars = 1, 0
    for i = 1, #q do
        local found = c:find(q:sub(i, i), ci, true)
        if found then chars = chars + 1 ci = found + 1 end
    end
    s = s + (chars / #q) * 150
    s = s - math.abs(#c - #q) * 2
    return s
end

local function bestMatch(name)
    local best, bestScore = nil, 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local s = scoreMatch(name, p.Name) + scoreMatch(name, p.DisplayName) * 0.85
            if s > bestScore then best, bestScore = p, s end
        end
    end
    return best, bestScore
end

