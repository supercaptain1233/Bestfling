--============ FLING ============
local function hrpOf(p)
    local c = p and p.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function flingOnce()
    local target = state.target
    if not state.on or not target then return end
    local myHrp = hrpOf(LP)
    local theirHrp = hrpOf(target)
    if not myHrp or not theirHrp then return end

    local dir = theirHrp.Position - myHrp.Position
    if dir.Magnitude < 0.5 then dir = Vector3.new(0, 0, 1) end
    dir = dir.Unit

    pcall(function()
        myHrp.CFrame = theirHrp.CFrame * CFrame.new(0, cfg.offsetY, 0)
    end)
    RunService.Heartbeat:Wait()
    if not state.on then return end

    pcall(function()
        myHrp.AssemblyLinearVelocity = dir * cfg.selfSpeed + Vector3.new(0, cfg.lift * 0.4, 0)
    end)

    local spin = Instance.new("BodyAngularVelocity")
    spin.AngularVelocity = Vector3.new(
        math.random(-cfg.spin, cfg.spin), 0, math.random(-cfg.spin, cfg.spin))
    spin.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    spin.Parent = myHrp
    task.delay(0.3, function() if spin then spin:Destroy() end end)

    task.delay(0.11, function()
        if not state.on then return end
        local t = hrpOf(target)
        if not t then return end
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = dir * cfg.targetSpeed + Vector3.new(0, cfg.lift, 0)
        bv.Parent = t
        task.delay(0.28, function() if bv then bv:Destroy() end end)
    end)
end

local function chase(token)
    while state.on and state.token == token do
        local target = state.target
        if not target or not target.Parent then
            if state.on then
                say("target left", Color3.fromRGB(240, 190, 90))
                setOff(true)
            end
            return
        end
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and hrp then
            flingOnce()
            task.wait(cfg.gap)
        else
            say("dead, waiting...", Color3.fromRGB(240, 190, 90))
            task.wait(0.08)
        end
    end
end

--============ ON / OFF ============
local function setOn()
    if state.on then return end
    local name = box.Text
    if name == "" then
        say("type a name first", Color3.fromRGB(240, 130, 130))
        return
    end
    local target, score = bestMatch(name)
    if not target or score < 45 then
        say("no match found", Color3.fromRGB(240, 130, 130))
        return
    end
    state.savedName = name
    state.target = target
    state.on = true
    state.token = state.token + 1

    local hrp = hrpOf(LP)
    state.home = hrp and hrp.CFrame or nil

    collisionOn = true
    installCollision(LP.Character)

    profiles[placeKey] = profiles[placeKey] or { hits = 0 }
    profiles[placeKey].hits = (profiles[placeKey].hits or 0) + 1
    profiles[placeKey].lastName = target.Name
    profiles[placeKey].lastAt = os.time()
    profiles[placeKey].collisionOff = not ((hrpOf(LP) and hrpOf(LP).CanCollide) or true)
    saveProfiles()

    toggle.Text = "ON"
    toggle.BackgroundColor3 = Color3.fromRGB(40, 130, 80)
    ts.Color = Color3.fromRGB(80, 220, 140)
    say("locked: " .. target.Name .. " (" .. math.floor(score) .. ")", Color3.fromRGB(120, 220, 160))

    task.spawn(chase, state.token)
end

function setOff(silent)
    if not state.on then return end
    state.on = false
    state.token = state.token + 1
    state.target = nil

    local hrp = hrpOf(LP)
    if hrp then
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
        if state.home then
            pcall(function() hrp.CFrame = state.home end)
        end
    end

    toggle.Text = "OFF"
    toggle.BackgroundColor3 = Color3.fromRGB(52, 52, 60)
    ts.Color = Color3.fromRGB(85, 85, 95)
    if not silent then say("off, returned home") end
end

toggle.Activated:Connect(function()
    if state.on then setOff() else setOn() end
end)

